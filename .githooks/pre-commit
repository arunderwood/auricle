#!/bin/sh
# Fast checks only (format + lint) — seconds, not minutes. The full
# build/test/xcodebuild gate (scripts/check.sh / `make check`) deliberately
# stays manual and CI's job: a hook that slow trains people to reach for
# `git commit --no-verify`, which defeats the point of having one.
#
# Not installed automatically — .git/hooks/ isn't tracked, so git doesn't
# look here unless told to. One-time setup: git config core.hooksPath .githooks
set -eu

# Not dirname "$0" the way scripts/check.sh does it: core.hooksPath is one
# absolute path shared by every worktree, so it names the wrong tree.
repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

echo "==> linting $repo_root"

# swiftformat applies every .swiftformat between its input and /, and worktrees
# sit under .claude/worktrees/ inside the main checkout — unpinned, a worktree
# inherits the main checkout's copy. The file is tracked; older revisions lack it.
if [ -f "$repo_root/.swiftformat" ]; then
    set -- --config "$repo_root/.swiftformat"
else
    set --
fi

echo "==> swiftformat --lint"
mise exec -- swiftformat --lint "$@" .

# No --config counterpart: swiftlint reads .swiftlint.yml from the working
# directory only, and a path here would re-root every excluded: entry in it.
echo "==> swiftlint"
mise exec -- swiftlint lint --strict .
